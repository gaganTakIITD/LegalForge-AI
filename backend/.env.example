# Use any OpenAI-compatible provider. Three common setups:
#
# OpenAI (default):
#   OPENAI_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# Google Gemini (OpenAI-compatible endpoint):
#   OPENAI_API_KEY=AIza...
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.0-flash
#
# Leave OPENAI_API_KEY empty to run in deterministic demo mode (no API calls).
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

JWT_SECRET=legalforge-hackathon-secret-2026
